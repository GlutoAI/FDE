# Local configuration template. This file contains NO real secrets.
# Copy to .env only when .env does not already exist; keep .env out of Git.
# Read by the backend only. Never add secrets under a VITE_ name.

TEMPLATE_ENV=local
TEMPLATE_MODEL_MODE=fixture
TEMPLATE_EXTERNAL_ACTIONS_ENABLED=false

# Optional overrides of backend/config/models.toml; blank keeps the catalog selection.
TEMPLATE_LLM_PROVIDER=
TEMPLATE_LLM_MODEL=

# One key per vendor, needed only for commands given --live. Hosted embeddings use the
# OpenAI key; Anthropic has no embeddings API.
TEMPLATE_OPENAI_API_KEY=
TEMPLATE_ANTHROPIC_API_KEY=

# Blank uses SQLite at backend/data/app.db. A PostgreSQL URL may embed a password,
# so it is treated as a secret and never printed.
TEMPLATE_DATABASE_URL=
