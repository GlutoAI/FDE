# Local application configuration template. This file contains NO real secrets.
# LLM, embedding, and SQLite database settings are implemented; auth, integrations, and
# Docker Compose are planned.
# Models default to backend/config/models.toml; blank overrides preserve that selection.
# Copy to .env only when that file does not already exist; keep .env out of Git.

CASHFLOW_ENV=local
CASHFLOW_MODEL_MODE=fixture
CASHFLOW_EXTERNAL_SENDING_ENABLED=false

# Optional overrides. CASHFLOW_LLM_PROVIDER (openai|anthropic) selects that vendor's
# profile in backend/config/models.toml; CASHFLOW_LLM_MODEL replaces its model ID.
CASHFLOW_LLM_PROVIDER=
CASHFLOW_LLM_MODEL=
# One key per vendor; supply keys only in ignored .env. No OPENAI_API_KEY or
# ANTHROPIC_API_KEY alias is loaded.
CASHFLOW_LLM_API_KEY=
CASHFLOW_ANTHROPIC_API_KEY=
# Embeddings are selected in backend/config/models.toml ([embedding_profiles]); hosted OpenAI
# embeddings reuse CASHFLOW_LLM_API_KEY. Anthropic offers no embeddings API.

# Blank uses SQLite at backend/data/app.db. A PostgreSQL URL (postgresql+asyncpg://...)
# may embed a password, so it is treated as a secret and never printed.
CASHFLOW_DATABASE_URL=

# Local PostgreSQL roles. Configure separate passwords when the DB is built.
# Each service receives only its role's credential, never the migration password.
CASHFLOW_DB_MIGRATION_PASSWORD=
CASHFLOW_DB_APP_PASSWORD=
CASHFLOW_DB_FINANCE_PASSWORD=
CASHFLOW_DB_EVIDENCE_PASSWORD=
CASHFLOW_DB_COLLECTIONS_PASSWORD=

# Local application/authentication secrets; populate when those components exist.
CASHFLOW_SESSION_SECRET=
CASHFLOW_OIDC_CLIENT_SECRET=
CASHFLOW_TOKEN_ENCRYPTION_KEY=

# Optional external integrations. These are not needed for the synthetic demo.
# Rotating per-tenant OAuth tokens belong in encrypted integration storage later,
# not in this template or in a shared static .env token entry.
CASHFLOW_QUICKBOOKS_CLIENT_ID=
CASHFLOW_QUICKBOOKS_CLIENT_SECRET=
CASHFLOW_MESSAGING_API_KEY=
